                    </Grid>
                    <Button Content="Удалить выбранное сохранение" Margin="0,0,0,8" Click="DeleteRecentSession_Click"/>
                    <CheckBox x:Name="AutosaveCheck" Style="{StaticResource ToggleSwitchStyle}" Content="Автосейв каждые 5 минут" Margin="0,0,0,8" Checked="Autosave_Changed" Unchecked="Autosave_Changed"/>
                    <TextBlock Text="ПОСЛЕДНИЕ" Style="{StaticResource LabelStyle}"/>
                    <ListBox x:Name="RecentSavesList"
                             Height="128"
                             Margin="0,4,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             MouseDoubleClick="RecentSavesList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="8" Background="#7807111D" BorderBrush="#203955" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Updated}" FontSize="10.5" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2"
                  Grid.Column="0"
                  Grid.ColumnSpan="4"
                  Margin="0,12,0,0"
                  Height="68"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="BottomActionsToggleButton"
                            Width="54"
                            Height="58"
                            Padding="0"
                            Margin="0,0,5,0"
                            Background="#D0071018"
                            BorderBrush="#243F5E"
                            ToolTip="Показать/скрыть быстрые действия"
                            Click="BottomActionsToggle_Click"
                            VerticalAlignment="Bottom">
                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 2 5 L 16 5 M 2 9 L 16 9 M 2 13 L 16 13"/>
                    </Button>
                    <Border x:Name="BottomActionsPanel"
                            Padding="5"
                            Background="#D0071018"
                            BorderBrush="#243F5E"
                            BorderThickness="1"
                            CornerRadius="8"
                            Effect="{StaticResource HudShadow}"
                            VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                    <Button x:Name="PauseBtn" Style="{StaticResource QuickActionButtonStyle}" Click="Pause_Click">
                        <StackPanel>
                            <TextBlock Text="II" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PauseButtonLabelText" Text="Пауза" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="Reset_Click">
                        <StackPanel>
                            <TextBlock Text="⟳" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Сброс" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="Screenshot_Click">
                        <StackPanel>
                            <TextBlock Text="◫" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Скриншот" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="SaveSession_Click">
                        <StackPanel>
                            <Path Width="17" Height="17" Stretch="Uniform" Stroke="#EAFBFF" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 3 4 L 7 4 L 9 6 L 15 6 L 15 14 L 3 14 Z M 6 10 L 12 10 M 9 7 L 9 13"/>
                            <TextBlock Text="Сессии" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickActionButtonStyle}" Margin="0" Click="BackToMenu_Click">
                        <StackPanel>
                            <TextBlock Text="☰" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Меню" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
