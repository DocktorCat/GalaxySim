            </Border>

            <Grid Grid.Row="1" Grid.Column="1" Margin="0,4,18,0" VerticalAlignment="Top">
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="8,-20,0,0"
                        Padding="12,4"
                        Background="#D009121C"
                        BorderBrush="#446A93"
                        BorderThickness="1"
                        CornerRadius="5"
                        Panel.ZIndex="2"
                        Visibility="Collapsed">
                    <TextBlock Text="ЛКМ — орбита  ·  колесо — зум"
                               FontSize="10"
                               Foreground="{StaticResource TextDim}"/>
                </Border>
                <Border x:Name="ContextPanel" Width="314" Background="{StaticResource PanelBgStrong}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="8" Visibility="Visible" Effect="{StaticResource HudGlow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
