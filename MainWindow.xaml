<Window x:Class="GalaxySim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Galaxy Sim"
        Width="1600" Height="960"
        MinWidth="1200" MinHeight="760"
        Background="#03060D"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#C6091320"/>
        <SolidColorBrush x:Key="PanelBgStrong" Color="#D507111D"/>
        <SolidColorBrush x:Key="PanelStroke" Color="#27476B"/>
        <SolidColorBrush x:Key="Accent" Color="#37D9FF"/>
        <SolidColorBrush x:Key="TextMain" Color="#EDF8FF"/>
        <SolidColorBrush x:Key="TextDim" Color="#8EA4BA"/>
        <SolidColorBrush x:Key="TextOk" Color="#9AF5D5"/>
        <DropShadowEffect x:Key="HudGlow" Color="#22D4FF" BlurRadius="16" ShadowDepth="0" Opacity="0.24"/>
        <DropShadowEffect x:Key="HudShadow" Color="#000000" BlurRadius="16" ShadowDepth="6" Opacity="0.38"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed"/>
        </Style>
        <Style x:Key="ComboToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="#294B70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#DDEFFF"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="{StaticResource TextOk}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#08111B"/>
            <Setter Property="BorderBrush" Value="#446B92"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="10,0,6,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                    <Path Grid.Column="1"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Stroke="{StaticResource Accent}"
                                          StrokeThickness="1.4"
                                          Data="M 0 0 L 4 4 L 8 0"/>
                                    <ToggleButton Grid.ColumnSpan="2"
                                                  Style="{StaticResource ComboToggleButtonStyle}"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="#F309121C"
                                        BorderBrush="{StaticResource Accent}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ScrollViewer MaxHeight="320">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#101B2B"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#111D2F"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#15273E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0B1725"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Background" Value="#D0081018"/>
            <Setter Property="BorderBrush" Value="#203955"/>
            <Setter Property="FontSize" Value="9"/>
        </Style>
        <Style x:Key="WindowControlButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#9CC9FF"/>
            <Setter Property="Background" Value="#120B1A2E"/>
            <Setter Property="BorderBrush" Value="#244D80"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#21345A"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#67B8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PreviewEyeButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Opacity" Value="0.42"/>
            <Setter Property="Background" Value="#D0020610"/>
            <Setter Property="BorderBrush" Value="#305A7B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#E7081422"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="SwitchTrack"
                                    Grid.Column="1"
                                    Width="34"
                                    Height="18"
                                    HorizontalAlignment="Right"
                                    Background="#223748"
                                    BorderBrush="#426985"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <Border x:Name="SwitchThumb"
                                        Width="12"
                                        Height="12"
                                        Margin="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#E5FAFF"
                                        CornerRadius="6"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#184B64"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Background" Value="#7CE7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderLineButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="2"
                                VerticalAlignment="Center"
                                CornerRadius="1"
                                Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Fill="#EAFBFF" Stroke="{StaticResource Accent}" StrokeThickness="1.2"/>
                            <Ellipse Margin="3" Fill="#8CEBFF"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,10"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="0,5,0,5">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderLineButtonStyle}" Background="#78D8FF"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderLineButtonStyle}" Background="#48627C"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F40B1523"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="6"
                                Margin="0,2"
                                Background="#73D7FF"
                                BorderBrush="#B9F4FF"
                                BorderThickness="0.6"
                                CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="#0A1118"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0A1118"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#0A1118">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="8"/>
                                <Setter Property="Width" Value="Auto"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RailButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Background" Value="#72040A12"/>
            <Setter Property="BorderBrush" Value="#1A334F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <Grid>
                                <Border x:Name="Glow" Margin="1" CornerRadius="5" Background="#2556D1FF" Opacity="0"/>
                                <Border x:Name="Edge" Width="2" HorizontalAlignment="Left" Margin="0,8,0,8" Background="{StaticResource Accent}" CornerRadius="2" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Frame" Property="Background" Value="#980B1723"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Frame" Property="Background" Value="#BC0B1A29"/>
                                <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                                <Setter TargetName="Edge" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootShell" Background="#03060D" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform Y="12"/>
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"/>
                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.28"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Border Margin="8,52,8,10"
                Background="#010203"
                BorderBrush="#2E547B"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True"
                MouseDown="Viewport_MouseDown"
                MouseMove="Viewport_MouseMove"
                MouseUp="Viewport_MouseUp"
                MouseWheel="Viewport_MouseWheel">
            <Grid>
                <Image x:Name="RenderImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"/>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.88" RadiusY="0.72">
                            <GradientStop Color="#00000000" Offset="0.56"/>
                            <GradientStop Color="#50040A12" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas x:Name="GalaxySelectionCanvas" IsHitTestVisible="False">
                    <Grid x:Name="GalaxySelectionMarker" Width="32" Height="32" Visibility="Collapsed">
                        <Ellipse Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#37D9FF" StrokeThickness="1.4" Opacity="0.88"/>
                        <Path Width="30" Height="30" Stretch="Fill" Stroke="#B9F4FF" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.78" Data="M 15 1 L 15 7 M 15 23 L 15 29 M 1 15 L 7 15 M 23 15 L 29 15"/>
                    </Grid>
                </Canvas>
            </Grid>
        </Border>

        <Grid Panel.ZIndex="2" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0"
                  Grid.ColumnSpan="4"
                  Height="42"
                  Margin="0,0,0,14"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="270"
                        Background="#D007101B"
                        BorderBrush="#284970"
                        BorderThickness="1"
                        CornerRadius="0,0,18,0"
                        Padding="18,5,14,5"
                        Effect="{StaticResource HudGlow}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#10274A" BorderBrush="{StaticResource Accent}" BorderThickness="1" Margin="0,0,12,0">
                            <Grid>
                                <Ellipse Margin="5" Stroke="#6DEAFF" StrokeThickness="1.6"/>
                                <Ellipse Width="8" Height="8" Fill="#8E62FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path Stroke="#37D9FF" StrokeThickness="1.2" Data="M 5 18 C 10 6 20 6 23 12"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="GALAXY SIM" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        Width="470"
                        Background="#D007101B"
                        BorderBrush="#284970"
                        BorderThickness="1"
                        CornerRadius="0,0,20,20"
                        Padding="16,5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Млечный Путь — Предустановка" FontSize="12" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="PresetCombo" Width="190" SelectionChanged="Preset_Changed">
                            <ComboBoxItem Content="Млечный Путь" IsSelected="True"/>
                            <ComboBoxItem Content="Андромеда (M31)"/>
                            <ComboBoxItem Content="NGC 1300 (барная)"/>
                            <ComboBoxItem Content="M74 Вертушка"/>
                            <ComboBoxItem Content="Карликовая галактика"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Grid Grid.Column="2" Width="238" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Border Width="198"
                            Height="42"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,0,0,0"
                            Background="#D007101B"
                            BorderBrush="#284970"
                            BorderThickness="1"
                            CornerRadius="0,0,0,18"
                            IsHitTestVisible="False"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button x:Name="TelemetryToggleButton" Style="{StaticResource WindowControlButtonStyle}" ToolTip="Показать/скрыть телеметрию" Click="TelemetryToggle_Click" Margin="0,0,8,0">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1 3 L 12 3 M 1 6.5 L 12 6.5 M 1 10 L 12 10"/>
                        </Button>
                        <Button Style="{StaticResource WindowControlButtonStyle}" Click="MinimizeWindow_Click">
                            <Path Width="12" Height="12" Stretch="Uniform" Stroke="#A8D7FF" StrokeThickness="1.8" Data="M 1 10 L 11 10"/>
                        </Button>
                        <Button Style="{StaticResource WindowControlButtonStyle}" Click="ToggleMaximizeWindow_Click">
                            <Path Width="11" Height="11" Stretch="Uniform" Stroke="#A8D7FF" StrokeThickness="1.7" Data="M 2 2 L 9 2 L 9 9 L 2 9 Z"/>
                        </Button>
                        <Button Style="{StaticResource WindowControlButtonStyle}" Margin="0" Click="CloseWindow_Click">
                            <Path Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  Stroke="#A8D7FF"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 2 2 L 10 10 M 10 2 L 2 10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border x:Name="GalaxyRailPanel"
                    Grid.Row="1"
                    Grid.Column="0"
                    Width="60"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    Padding="6,11"
                    Background="#68000000"
                    BorderBrush="#17324F"
                    BorderThickness="1"
                    CornerRadius="0,8,8,0"
                    VerticalAlignment="Top"
                    Effect="{StaticResource HudShadow}">
                <StackPanel>
                    <ToggleButton x:Name="SceneNavButton" Style="{StaticResource RailButtonStyle}" Visibility="Collapsed" Click="NavSection_Click" Tag="Scene" ToolTip="Сцена">
                        <Grid Width="25" Height="25">
                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="4" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
