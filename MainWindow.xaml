                                        <Slider x:Name="BloomThresholdSlider" Minimum="0.1" Maximum="3.0" Value="0.8" ValueChanged="BloomThreshold_Changed"/>
                                        <Grid><TextBlock Text="Интенсивность" Style="{StaticResource LabelStyle}"/><TextBlock Style="{StaticResource ValueStyle}" Text="{Binding ElementName=BloomIntensitySlider, Path=Value, StringFormat={}{0:F2}}"/></Grid>
