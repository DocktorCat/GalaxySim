<Window x:Class="GalaxySim.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Galaxy Sim Launcher"
        Width="1280"
        Height="780"
        MinWidth="1120"
        MinHeight="700"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#020713"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Color x:Key="PanelStrokeColor">#4D8FE9FF</Color>
        <Color x:Key="PanelFillColor">#BC031127</Color>
        <Color x:Key="TextPrimaryColor">#F0F6FF</Color>
        <Color x:Key="TextSecondaryColor">#AEBBD2</Color>
        <Color x:Key="AccentColor">#2C98FF</Color>

        <LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#020713" Offset="0.0"/>
            <GradientStop Color="#05122B" Offset="0.52"/>
            <GradientStop Color="#020817" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PanelFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D7051228" Offset="0.0"/>
            <GradientStop Color="#B8020A1A" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InputFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0A1B34" Offset="0.0"/>
            <GradientStop Color="#041026" Offset="0.52"/>
            <GradientStop Color="#07162C" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="StartButtonFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#16B6FF" Offset="0.0"/>
            <GradientStop Color="#078BFF" Offset="0.38"/>
            <GradientStop Color="#085EDE" Offset="0.76"/>
            <GradientStop Color="#133B9F" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ExitButtonFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#172338" Offset="0.0"/>
            <GradientStop Color="#0D182A" Offset="1.0"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="BlueGlow"
                          Color="#248BFF"
                          BlurRadius="18"
                          ShadowDepth="0"
                          Opacity="0.55"/>

        <DropShadowEffect x:Key="SoftGlow"
                          Color="#5CB6FF"
                          BlurRadius="12"
                          ShadowDepth="0"
                          Opacity="0.35"/>

        <Style x:Key="ChromePanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelFill}"/>
            <Setter Property="BorderBrush" Value="#5B87C9FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect" Value="{StaticResource SoftGlow}"/>
        </Style>

        <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#C9D9F6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#C3CEE2"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="IconBoxStyle" TargetType="Border">
            <Setter Property="Width" Value="66"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#356FB8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#12315A" Offset="0"/>
                        <GradientStop Color="#07162D" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect" Value="{StaticResource SoftGlow}"/>
        </Style>

        <Style x:Key="ComboScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="#061226"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#061226">
                            <Border Margin="3,4"
                                    Background="#14345E"
                                    CornerRadius="2"
                                    Opacity="0.6"/>
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="8"
                                                        Margin="1"
                                                        CornerRadius="4"
                                                        Background="#2B8CEB">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#32AFFF"
                                                                          BlurRadius="7"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.75"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2F7FF"/>
            <Setter Property="Background" Value="{StaticResource InputFill}"/>
            <Setter Property="BorderBrush" Value="#426EAD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="MaxDropDownHeight" Value="168"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          Padding="{TemplateBinding Padding}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="InputChrome"
                                                Background="{StaticResource InputFill}"
                                                BorderBrush="#4D7DBB"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                TextElement.Foreground="#F0F6FF">
                                            <Grid>
                                                <Border Height="1"
                                                        Margin="1,1,32,0"
                                                        VerticalAlignment="Top"
                                                        Background="#35A7E6FF"/>
                                                <TextBlock Margin="{TemplateBinding Padding}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           Foreground="#F0F6FF"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path Width="13"
                                                      Height="8"
                                                      Margin="0,0,16,0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Stroke="#A8C8EF"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M 0 0 L 6.5 6 L 13 0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="#81C7FF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="#8ED1FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,5,0,0"
                                        Background="#071326"
                                        BorderBrush="#5798E6"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <ScrollViewer>
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ComboScrollBarStyle}"/>
                                        </ScrollViewer.Resources>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="Background" Value="#071326"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#163A69"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#0E4C92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommandButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F1F7FF"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#142135"/>
            <Setter Property="BorderBrush" Value="#4778BFFF"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Path x:Name="ButtonChrome"
                                  Fill="{TemplateBinding Background}"
                                  Stroke="{TemplateBinding BorderBrush}"
                                  StrokeThickness="1"
                                  Stretch="Fill"
                                  Data="M 15 0 L 281 0 L 296 15 L 296 57 L 281 72 L 15 72 L 0 57 L 0 15 Z">
                                <Path.Effect>
                                    <DropShadowEffect Color="#0A5CBA" BlurRadius="8" ShadowDepth="0" Opacity="0.22"/>
                                </Path.Effect>
                            </Path>
                            <Path x:Name="ButtonInnerGlow"
                                  Margin="5"
                                  Fill="#00000000"
                                  Stroke="#2A9CFF"
                                  StrokeThickness="1"
                                  Opacity="0.62"
                                  Stretch="Fill"
                                  Data="M 13 0 L 273 0 L 286 13 L 286 49 L 273 62 L 13 62 L 0 49 L 0 13 Z"/>
                            <Border Width="136"
                                    Height="22"
                                    Margin="0,0,0,40"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#55BFFFFF"
                                    Opacity="0.35"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <BlurEffect Radius="16"/>
                                </Border.Effect>
                            </Border>
                            <Border Height="1"
                                    Margin="18,2,18,0"
                                    VerticalAlignment="Top"
                                    Background="#91DFFFFF"/>
                            <Border Height="1"
                                    Margin="18,0,18,2"
                                    VerticalAlignment="Bottom"
                                    Background="#1D7FC8FF"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Stroke" Value="#8BCFFF"/>
                                <Setter TargetName="ButtonChrome" Property="Effect" Value="{StaticResource BlueGlow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.84"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1.015" Duration="0:0:0.11"/>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1.015" Duration="0:0:0.11"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.11"/>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.11"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="#9CC9FF"/>
            <Setter Property="Background" Value="#120B1A2E"/>
            <Setter Property="BorderBrush" Value="#244D80"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#21345A"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#67B8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Image x:Name="MenuBackgroundImage"
               Stretch="UniformToFill"
               Opacity="0.72"
               IsHitTestVisible="False"/>

        <Grid Height="30"
              VerticalAlignment="Top"
              Background="#76030A18"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Path Width="16"
                      Height="16"
                      Margin="0,0,8,0"
                      Stretch="Uniform"
                      Stroke="#5DBDFF"
                      StrokeThickness="1.5"
                      Data="M 8 1 L 14 4.5 L 14 11.5 L 8 15 L 2 11.5 L 2 4.5 Z"/>
                <TextBlock Text="GALAXY SIM"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#8FB7E6"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Height="1"
                    Margin="16,0,16,0"
                    VerticalAlignment="Center"
                    Background="#245E9C"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,2,8,0">
                <Button Style="{StaticResource TitleBarButtonStyle}" Click="Minimize_Click">
                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="#A8D7FF" StrokeThickness="1.8" Data="M 1 10 L 11 10"/>
                </Button>
                <Button Style="{StaticResource TitleBarButtonStyle}" Margin="6,0,0,0" Click="Close_Click">
                    <Path Width="12"
                          Height="12"
                          Stretch="Uniform"
                          Stroke="#A8D7FF"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 2 2 L 10 10 M 10 2 L 2 10"/>
                </Button>
            </StackPanel>
        </Grid>

        <Canvas IsHitTestVisible="False" Opacity="0.68">
            <Ellipse Canvas.Left="88" Canvas.Top="178" Width="2" Height="2" Fill="#9EC9FF"/>
            <Ellipse Canvas.Left="180" Canvas.Top="80" Width="1.6" Height="1.6" Fill="#DDEBFF"/>
            <Ellipse Canvas.Left="336" Canvas.Top="126" Width="2.4" Height="2.4" Fill="#6DA9FF"/>
            <Ellipse Canvas.Left="514" Canvas.Top="48" Width="1.5" Height="1.5" Fill="#BFD9FF"/>
            <Ellipse Canvas.Left="790" Canvas.Top="23" Width="1.8" Height="1.8" Fill="#FFFFFF"/>
            <Ellipse Canvas.Left="1038" Canvas.Top="110" Width="2.2" Height="2.2" Fill="#8ABFFF"/>
            <Ellipse Canvas.Left="1190" Canvas.Top="302" Width="1.4" Height="1.4" Fill="#D7E8FF"/>
            <Ellipse Canvas.Left="116" Canvas.Top="612" Width="1.3" Height="1.3" Fill="#9EC9FF"/>
            <Ellipse Canvas.Left="704" Canvas.Top="652" Width="2" Height="2" Fill="#DDEBFF"/>
            <Ellipse Canvas.Left="1218" Canvas.Top="586" Width="1.5" Height="1.5" Fill="#76AFFF"/>
        </Canvas>

        <Grid x:Name="RootShell" Margin="36,42,36,34" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="16"/>
            </Grid.RenderTransform>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35"/>
                            <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.35"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <Grid.RowDefinitions>
                <RowDefinition Height="118"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="112"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,0,0,0">
                    <Grid Width="430" Height="66">
                        <TextBlock Text="GALAXY SIM"
                                   Margin="0,1,0,0"
                                   FontFamily="Segoe UI Black"
                                   FontSize="60"
                                   FontWeight="Black"
                                   Foreground="#203F86"
                                   Opacity="0.65"/>
                        <TextBlock Text="GALAXY SIM"
                                   FontFamily="Segoe UI Black"
                                   FontSize="60"
                                   FontWeight="Black"
                                   Effect="{StaticResource BlueGlow}">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="#EEF5FF" Offset="0.38"/>
                                    <GradientStop Color="#A9CDFF" Offset="0.72"/>
                                    <GradientStop Color="#6EA4F4" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <Border Height="2"
                                Width="392"
                                Margin="2,0,0,0"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#A9DFFFFF" Offset="0.18"/>
                                    <GradientStop Color="#4F8FE4FF" Offset="0.82"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#42A8FF" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="SubtitleText"
                               Text="Стартовые настройки сцены"
                               FontSize="20"
                               Foreground="#9EACC4"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <Grid Width="178"
                      Height="46"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,14,8,0">
                    <ComboBox x:Name="LanguageCombo"
                              Width="178"
                              Height="46"
                              Padding="48,0,14,0"
                              FontSize="16"
                              SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Content="Русский"/>
                        <ComboBoxItem Content="English"/>
                    </ComboBox>
                    <Ellipse Width="20"
                             Height="20"
                             Margin="14,0,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Stroke="#64BDFF"
                             StrokeThickness="1.7"
                             IsHitTestVisible="False"/>
                    <Path Width="18"
                          Height="18"
                          Margin="15,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Stroke="#64BDFF"
                          StrokeThickness="1.3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 9 0 C 5 4 5 14 9 18 M 9 0 C 13 4 13 14 9 18 M 0 9 L 18 9 M 2.5 4.5 L 15.5 4.5 M 2.5 13.5 L 15.5 13.5"
                          IsHitTestVisible="False"/>
                </Grid>
            </Grid>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,8,20,0"
                    Style="{StaticResource ChromePanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="4,0,0,14">
                        <Border Width="34"
                                Height="34"
                                CornerRadius="8"
                                BorderBrush="#4A89D8"
                                BorderThickness="1"
                                Background="#102341"
                                Margin="0,0,12,0">
                            <Path Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Stroke="#66BCFF"
                                  StrokeThickness="2"
                                  Data="M 8 1 L 14 4.5 L 14 11.5 L 8 15 L 2 11.5 L 2 4.5 Z M 8 6 A 2 2 0 1 0 8 10 A 2 2 0 1 0 8 6"/>
                        </Border>
                        <TextBlock x:Name="SettingsHeaderText"
                                   Text="НАСТРОЙКИ СЦЕНЫ"
                                   Style="{StaticResource PanelHeaderStyle}"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Height="1"
                            Margin="60,0,190,0"
                            Background="#1B3E67"/>

                    <Grid Grid.Row="2" Margin="6,18,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBoxStyle}">
                                <Path Width="34"
                                      Height="34"
                                      Stretch="Uniform"
                                      Fill="#8CD5FF"
                                      Data="M 16 0 L 20.5 11.5 L 32 16 L 20.5 20.5 L 16 32 L 11.5 20.5 L 0 16 L 11.5 11.5 Z"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ParticleLabelText"
                                           Text="Количество звёзд"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="ParticlePresetCombo"
                                          SelectionChanged="AnyCombo_SelectionChanged"
                                          DisplayMemberPath="Label"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBoxStyle}">
                                <Grid Width="40" Height="40">
                                    <Ellipse Width="32"
                                             Height="18"
                                             Stroke="#5EC3FF"
                                             StrokeThickness="2.2"
                                             Opacity="0.95"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-12"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse Width="22"
                                             Height="10"
                                             Stroke="#8DDCFF"
                                             StrokeThickness="2"
                                             Opacity="0.78"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-12"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="#9BE4FF"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="GalaxyLabelText"
                                           Text="Тип галактики"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="GalaxyPresetCombo"
                                          SelectionChanged="AnyCombo_SelectionChanged"
                                          DisplayMemberPath="Label"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBoxStyle}">
                                <Path Width="36"
                                      Height="36"
                                      Stretch="Uniform"
                                      Stroke="#65C4FF"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      Data="M 5 7 L 31 7 L 31 25 L 5 25 Z M 14 31 L 22 31 M 18 25 L 18 31"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ResolutionLabelText"
                                           Text="Разрешение рендера"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="RenderResolutionCombo"
                                          SelectionChanged="AnyCombo_SelectionChanged"
                                          DisplayMemberPath="Label"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,8,0,0"
                    Style="{StaticResource ChromePanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="74"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="4,0,0,14">
                        <Border Width="34"
                                Height="34"
                                CornerRadius="8"
                                BorderBrush="#4A89D8"
                                BorderThickness="1"
                                Background="#102341"
                                Margin="0,0,12,0">
                            <Path Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Stroke="#66BCFF"
                                  StrokeThickness="2"
                                  Fill="Transparent"
                                  Data="M 1 9 C 5 3 13 3 17 9 C 13 15 5 15 1 9 Z M 9 6 A 3 3 0 1 0 9 12 A 3 3 0 1 0 9 6"/>
                        </Border>
                        <TextBlock x:Name="PreviewTitleText"
                                   Text="Предпросмотр пресета"
                                   Style="{StaticResource PanelHeaderStyle}"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="4,8,4,22"
                            Background="#B8061022"
                            BorderBrush="#3E75B9"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="178"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="166"
                                    Height="202"
                                    CornerRadius="4"
                                    Background="#081226"
                                    BorderBrush="#102A50"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <Grid>
                                    <Canvas x:Name="PreviewFallback" Background="#040916">
                                        <Ellipse Canvas.Left="-40" Canvas.Top="30" Width="250" Height="150" Fill="#20155E" Opacity="0.48">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-24" CenterX="125" CenterY="75"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Canvas.Left="4" Canvas.Top="58" Width="170" Height="94" Stroke="#5CB5FF" StrokeThickness="2" Opacity="0.7">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-24" CenterX="85" CenterY="47"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Canvas.Left="30" Canvas.Top="75" Width="118" Height="58" Stroke="#D4A9FF" StrokeThickness="2" Opacity="0.65">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-24" CenterX="59" CenterY="29"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Canvas.Left="67" Canvas.Top="92" Width="48" Height="28" Fill="#FFE2BD" Opacity="0.88">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-24" CenterX="24" CenterY="14"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Canvas.Left="20" Canvas.Top="26" Width="2" Height="2" Fill="#FFFFFF"/>
                                        <Ellipse Canvas.Left="54" Canvas.Top="172" Width="2" Height="2" Fill="#78B8FF"/>
                                        <Ellipse Canvas.Left="118" Canvas.Top="38" Width="2" Height="2" Fill="#C9E3FF"/>
                                        <Ellipse Canvas.Left="138" Canvas.Top="190" Width="1.6" Height="1.6" Fill="#FFFFFF"/>
                                    </Canvas>
                                    <Image x:Name="PresetPreviewImage"
                                           Stretch="UniformToFill"
                                           Opacity="0"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="20,14,6,0">
                                <TextBlock x:Name="PresetNameText"
                                           Text="Млечный Путь"
                                           FontSize="29"
                                           FontWeight="Bold"
                                           Foreground="#F7F6F3"/>
                                <TextBlock x:Name="PresetStarsText"
                                           Text="128,000 звёзд | 1280x720"
                                           FontSize="16"
                                           FontFamily="Consolas"
                                           Foreground="#69AFFF"
                                           Margin="0,10,0,0"/>
                                <TextBlock x:Name="PresetDescriptionText"
                                           Text="Профиль по умолчанию с высокой визуальной плотностью."
                                           TextWrapping="Wrap"
                                           LineHeight="22"
                                           FontSize="16"
                                           Foreground="#C6CDDA"
                                           Margin="0,14,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,0,0,0"
                            Background="#B70B1730"
                            BorderBrush="#356DAF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30"
                                    Height="30"
                                    CornerRadius="15"
                                    BorderBrush="#3A85D6"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="i"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#62AFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TipText"
                                       Grid.Column="1"
                                       Text="Совет: для 512K/1M начни с 1280x720 или 1600x900, затем повышай разрешение."
                                       TextWrapping="Wrap"
                                       FontSize="15"
                                       LineHeight="20"
                                       Foreground="#9EACC5"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,18,0,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="296"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="264"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="ExitButton"
                        Grid.Column="0"
                        Style="{StaticResource CommandButtonStyle}"
                        Background="{StaticResource ExitButtonFill}"
                        BorderBrush="#45648B"
                        Click="Exit_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="25"
                              Height="25"
                              Margin="0,0,14,0"
                              Stretch="Uniform"
                              Stroke="#A9B8CF"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M 12 4 L 4 4 L 4 21 L 12 21 M 10 12.5 L 23 12.5 M 18 7 L 23 12.5 L 18 18"/>
                        <TextBlock x:Name="ExitButtonText"
                                   Text="Выйти из приложения"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="StartButton"
                        Grid.Column="2"
                        Style="{StaticResource CommandButtonStyle}"
                        Background="{StaticResource StartButtonFill}"
                        BorderBrush="#77BDFF"
                        Effect="{StaticResource BlueGlow}"
                        Click="Start_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="27"
                              Height="27"
                              Margin="0,0,16,0"
                              Stretch="Uniform"
                              Fill="#F4FAFF"
                              Data="M 4 2 L 24 13.5 L 4 25 Z"/>
                        <TextBlock x:Name="StartButtonText"
                                   Text="Запустить"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
